PORT=3001
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
CORS_ORIGIN=http://localhost:5173
# Optional. Kosongkan untuk Railway fullstack satu service.
PROCESSOR_API_KEY=
PROCESSOR_BASE_URL=
UPLOAD_RATE_LIMIT_PER_MINUTE=4
PREPROCESS_MAX_DIMENSION=2048
TRACE_THRESHOLD=180
TRACE_TURD_SIZE=4
TRACE_OPT_TOLERANCE=0.18

GLM_API_KEY=
GLM_API_BASE_URL=https://api.z.ai/api/paas/v4
GLM_ANALYSIS_MODEL=glm-5v-turbo
GLM_IMAGE_MODEL=glm-image
GLM_IMAGE_QUALITY=hd
AI_REDRAW_PRESET=quality
LOGO_RESTORE_ENABLED=1

# Optional fallback jika GLM belum sebagus Gemini untuk beberapa gambar.
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.1-flash-lite-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

SUPABASE_PROJECT_REF=PROJECT-REF
SUPABASE_URL=https://PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://PROJECT-REF.supabase.co/auth/v1/callback

VITE_SUPABASE_URL=https://PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:3001
VITE_GOOGLE_OAUTH_REDIRECT_TO=http://localhost:5173

# Production Railway fullstack:
# - kosongkan VITE_API_BASE_URL agar frontend memakai same-origin /api
# - set VITE_GOOGLE_OAUTH_REDIRECT_TO ke domain Railway/custom domain
# VITE_GOOGLE_OAUTH_REDIRECT_TO=https://designmudah.pages.dev
